// Database schema for the shop platform.
//
// Rules that hold everywhere:
//  - Every main table carries storeId, so one database can serve many shops.
//  - Money is whole paisa (Int). Rs 1,250.50 = 125050.
//  - Orders copy names and prices at the time of purchase, so editing a
//    product later never changes an old order.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Shops ──────────────────────────────────────────────────────────────

model Store {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  domain    String?  @unique
  currency  String   @default("NPR")
  isActive  Boolean  @default(true)
  /// Theme, logo, contact info, enabled payment methods, feature switches.
  settings  Json     @default("{}")
  /// Last order number used; incremented inside the order transaction.
  orderSeq  Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff      StaffUser[]
  customers  Customer[]
  categories Category[]
  suppliers  Supplier[]
  products   Product[]
  variants   ProductVariant[]
  orders     Order[]
  payouts    SupplierPayout[]
}

enum StaffRole {
  OWNER
  ADMIN
  STAFF
}

model StaffUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  storeId      String    @db.Uuid
  name         String
  email        String
  phone        String?
  passwordHash String
  role         StaffRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store  Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  events OrderEvent[]

  @@unique([storeId, email])
}

// ─── Customers ──────────────────────────────────────────────────────────

/// Buyers are identified by phone number; guest checkout creates one too.
model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   String   @db.Uuid
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]

  @@unique([storeId, phone])
}

model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @db.Uuid
  fullName   String
  phone      String
  province   String
  district   String
  city       String
  area       String
  landmark   String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─── Catalogue ──────────────────────────────────────────────────────────

model Category {
  id           String   @id @default(uuid(7)) @db.Uuid
  storeId      String   @db.Uuid
  parentId     String?  @db.Uuid
  name         String
  slug         String
  imageUrl     String?
  sortOrder    Int      @default(0)
  /// Other languages, e.g. { "ne": { "name": "कुर्ता" } }. English stays in the main fields.
  translations Json     @default("{}")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, parentId])
}

/// Whoever supplies the goods. We owe them the wholesale price for each sold item.
model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   String   @db.Uuid
  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]
  payouts    SupplierPayout[]

  @@index([storeId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String        @id @default(uuid(7)) @db.Uuid
  storeId        String        @db.Uuid
  categoryId     String?       @db.Uuid
  supplierId     String?       @db.Uuid
  name           String
  slug           String
  description    String?
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  tags           String[]
  seoTitle       String?
  seoDescription String?
  /// Other languages, e.g. { "ne": { "name": "…", "description": "…" } }.
  translations   Json          @default("{}")
  /// Cheapest / dearest active variant price in paisa. Kept up to date by
  /// refreshProductSummary() so lists can sort and filter by price quickly.
  minPrice       Int           @default(0)
  maxPrice       Int           @default(0)
  /// Total stock across active variants.
  totalStock     Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  options  ProductOption[]
  variants ProductVariant[]
  images   ProductImage[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt])
  @@index([storeId, status, minPrice])
  @@index([storeId, categoryId])
}

/// e.g. "Size" or "Colour".
model ProductOption {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @db.Uuid
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

/// e.g. "M", "XL", "Red".
model ProductOptionValue {
  id       String  @id @default(uuid(7)) @db.Uuid
  optionId String  @db.Uuid
  value    String
  /// Colour swatch, e.g. "#c0392b". Only for colour-like options.
  swatch   String?
  position Int     @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]
  images   ProductImage[]

  @@unique([optionId, value])
}

/// One buyable item: a product in one size and one colour.
model ProductVariant {
  id             String   @id @default(uuid(7)) @db.Uuid
  storeId        String   @db.Uuid
  productId      String   @db.Uuid
  sku            String
  /// Selling price in paisa.
  price          Int
  /// Old price shown crossed out, in paisa.
  compareAtPrice Int?
  /// What we owe the supplier per unit, in paisa. Never shown to buyers.
  wholesalePrice Int      @default(0)
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  orderItems   OrderItem[]

  @@unique([storeId, sku])
  @@index([productId])
}

model VariantOptionValue {
  variantId     String @db.Uuid
  optionValueId String @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductImage {
  id            String   @id @default(uuid(7)) @db.Uuid
  productId     String   @db.Uuid
  /// Set when the photo shows one colour, so picking "Red" shows red photos.
  optionValueId String?  @db.Uuid
  url           String
  alt           String?
  width         Int?
  height        Int?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, position])
}

// ─── Orders ─────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

/// Methods are listed ahead of time so wallets can be switched on later
/// without a database change. Only COD is implemented at launch.
enum PaymentMethod {
  COD
  ESEWA
  KHALTI
  FONEPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(uuid(7)) @db.Uuid
  storeId       String        @db.Uuid
  /// Human-friendly number shown to buyers, unique per shop (e.g. 1001).
  orderNumber   Int
  customerId    String        @db.Uuid
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  subtotal    Int
  shippingFee Int @default(0)
  discount    Int @default(0)
  total       Int

  // Delivery address, copied at the time of order.
  shipName     String
  shipPhone    String
  shipProvince String
  shipDistrict String
  shipCity     String
  shipArea     String
  shipLandmark String?

  customerNote String?
  staffNote    String?
  /// Facebook / Instagram / TikTok campaign info (utm_*), for measuring ads.
  source       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @db.Uuid
  variantId      String? @db.Uuid
  supplierId     String? @db.Uuid
  /// Set once this item has been settled with the supplier.
  payoutId       String? @db.Uuid
  productName    String
  /// e.g. "M / Red"
  variantTitle   String
  sku            String
  imageUrl       String?
  unitPrice      Int
  wholesalePrice Int
  quantity       Int
  lineTotal      Int

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  supplier Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payout   SupplierPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([supplierId, payoutId])
}

/// One attempt to collect money for an order. COD creates one that is
/// marked PAID when the rider hands over the cash.
model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  orderId      String        @db.Uuid
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Int
  /// Transaction id from eSewa / Khalti etc.
  providerRef  String?
  /// Raw response from the provider, kept for disputes.
  providerData Json?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([method, providerRef])
}

/// History of status changes, shown in admin and used for audits.
model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @db.Uuid
  staffId    String?      @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff StaffUser? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ─── Supplier settlement ────────────────────────────────────────────────

enum PayoutStatus {
  PENDING
  PAID
}

/// A batch of delivered items paid to a supplier at wholesale price.
model SupplierPayout {
  id         String       @id @default(uuid(7)) @db.Uuid
  storeId    String       @db.Uuid
  supplierId String       @db.Uuid
  amount     Int
  status     PayoutStatus @default(PENDING)
  note       String?
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    OrderItem[]

  @@index([storeId, supplierId, status])
}
