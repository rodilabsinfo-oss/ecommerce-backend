NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# Comma separated list of allowed browser origins (storefront + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Store used when a request does not say which store it is for
DEFAULT_STORE_SLUG=main

# Public address of this API (photo links when using local storage)
PUBLIC_URL=http://localhost:4000

# Staff login
SESSION_DAYS=30
COOKIE_SECURE=false

# Photos: local (./uploads) or s3 (S3 / Cloudflare R2)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=shop-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://photos.example.com
